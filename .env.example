# Copy this file to ".env" and edit. Every value has a safe default for local development.

# --- General ---------------------------------------------------------------
APP_NAME=Registration App          # shown in the menu bar, emails and SMS
PORT=3000
BASE_URL=http://localhost:3000     # public address; used in the email links. Must be https:// in production
# NODE_ENV=production              # turns on the production safety checks below
APP_SECRET=                        # REQUIRED in production: a long random string (openssl rand -hex 32)

# --- Database (PostgreSQL) ---------------------------------------------------
# REQUIRED. A Neon connection string looks like:
#   postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# For a local Postgres instead: postgresql://postgres:postgres@localhost:5432/registration_app
DATABASE_URL=

# --- HTTPS / TLS 1.3 (requirement 1b-i) -------------------------------------
# Option A: this server terminates TLS itself (TLS 1.3 only)
# TLS_KEY_FILE=/etc/ssl/private/app.key
# TLS_CERT_FILE=/etc/ssl/certs/app.crt
# HTTP_REDIRECT_PORT=80            # optional: port that redirects http -> https
# Option B: a reverse proxy (nginx, Caddy, a load balancer) terminates TLS 1.3
# TRUST_PROXY=1                    # number of proxies in front of the app
# Local testing with a self-signed certificate:  npm run dev:https

# --- Email (SMTP) ------------------------------------------------------------
# Without these, development mode shows emails in the "Dev inbox" instead of sending them.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# ...or:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Registration App <no-reply@example.com>"

# --- SMS one-time codes --------------------------------------------------------
# Pick ONE. If more than one is set, TextBee wins, then Semaphore, then Twilio.
#
# Option A: TextBee (textbee.dev) - sends through a paired Android phone's own SIM
# and carrier plan. Genuinely free (beyond whatever your own phone plan already costs).
# TEXTBEE_API_KEY=
# TEXTBEE_DEVICE_ID=
#
# Option B: Semaphore (semaphore.co) - Philippine SMS gateway, pay-as-you-go, no monthly fee.
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=              # optional: a sender name you've registered with Semaphore
#
# Option C: Twilio - international, free trial credit, but trial accounts can only
# text verified numbers and need Philippines enabled under Geo Permissions.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567         # or use TWILIO_MESSAGING_SERVICE_SID=

# --- Rules from the requirements (defaults shown) -----------------------------
# REGISTER_LIMIT_PER_HOUR=5        # registration requests per IP per hour
# MAX_FAILED_LOGINS=3
# UNLOCK_COOLDOWN_SECONDS=120      # 2-minute cooling period before an unlock link works
# UNLOCK_TOKEN_TTL_MINUTES=60
# EMAIL_TOKEN_TTL_HOURS=24
# OTP_TTL_MINUTES=5
# OTP_MAX_ATTEMPTS=3
# OTP_RESEND_SECONDS=60
# OTP_LOCK_MINUTES=15              # how long OTP entry stays locked after 3 wrong codes
# SESSION_HOURS=8

# --- Password hashing (Argon2id) ----------------------------------------------
# ARGON2_MEMORY_KIB=65536          # 64 MiB
# ARGON2_TIME_COST=3
# ARGON2_PARALLELISM=1

# --- Development helpers (refused in production) ------------------------------
# DEV_OUTBOX=1                     # show emails / SMS codes in the app (localhost only)
# DEV_HTTPS=1                      # HTTPS with an auto-generated self-signed certificate
